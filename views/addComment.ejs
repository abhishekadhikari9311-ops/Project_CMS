<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Add Comment | MyBlog</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        min-height: 100vh;
        background: linear-gradient(135deg, #e0e7ff, #f5f3ff, #fce7f3);
        display: flex;
        flex-direction: column;
      }

      /* Navbar */
      .navbar {
        width: 100%;
        padding: 20px 8%;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
      }

      .logo {
        color: #5b21b6;
        font-size: 25px;
        font-weight: bold;
        text-decoration: none;
      }

      .home-link {
        color: #4b5563;
        text-decoration: none;
        font-size: 15px;
        font-weight: bold;
      }

      .home-link:hover {
        color: #7c3aed;
      }

      /* Main Section */
      .main-container {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
      }

      .comment-card {
        width: 100%;
        max-width: 600px;
        background: #ffffff;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 15px 45px rgba(91, 33, 182, 0.12);
      }

      .icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 18px;
        background: #ede9fe;
        color: #6d28d9;
        font-size: 32px;
      }

      h1 {
        text-align: center;
        color: #1f2937;
        font-size: 30px;
        margin-bottom: 12px;
      }

      .description {
        text-align: center;
        color: #6b7280;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
      }

      .form-group {
        margin-bottom: 22px;
      }

      label {
        display: block;
        color: #374151;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 10px;
      }

      .comment-input {
        width: 100%;
        min-height: 150px;
        padding: 16px;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        font-size: 15px;
        line-height: 1.6;
        color: #1f2937;
        resize: vertical;
        outline: none;
        transition: 0.3s ease;
      }

      .comment-input:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
      }

      .comment-input::placeholder {
        color: #9ca3af;
      }

      /* Submit Input */
      .submit-input {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        color: #ffffff;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s ease;
      }

      .submit-input:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(91, 33, 182, 0.25);
      }

      .back-link {
        display: block;
        margin-top: 22px;
        text-align: center;
        color: #6d28d9;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      /* Footer */
      footer {
        text-align: center;
        padding: 20px;
        color: #6b7280;
        font-size: 13px;
      }

      @media (max-width: 600px) {
        .navbar {
          padding: 18px 5%;
        }

        .comment-card {
          padding: 25px 20px;
        }

        h1 {
          font-size: 25px;
        }
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar">
      <a href="/blog" class="logo">MyBlog.</a>
      <a href="/blog" class="home-link">← Back to Home</a>
    </nav>

    <!-- Add Comment Form -->
    <main class="main-container">
      <section class="comment-card">
        <div class="icon">💬</div>

        <h1>Write a Comment</h1>

        <p class="description">
          Share your thoughts, express your opinion, and join the conversation
          with our community.
        </p>

        <form action="/comment/add-comment/<%= blogId %>" method="POST">
          <div class="form-group">
            <label for="CommentMessage"> Your Comment </label>

            <textarea
              class="comment-input"
              id="CommentMessage"
              name="CommentMessage"
              placeholder="Write your comment here..."
              minlength="2"
              maxlength="1000"
              required
            ></textarea>
          </div>

          <input type="submit" class="submit-input" value="Post Comment" />
        </form>

        <a href="/blog" class="back-link"> Cancel and return to blogs </a>
      </section>
    </main>
<!-- 
    <%= 
    
    %> -->

    <!-- Footer -->
    <footer>
      © <%= new Date().getFullYear() %> MyBlog. All rights reserved.
    </footer>
  </body>
</html>
