<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Add New Blog | MyBlog</title>

    <link rel="stylesheet" href="styles/addBlog.css">
    
  </head>

  <body>
    <!-- =========================
       NAVBAR
  ========================== -->

    <nav class="navbar">
      <div class="logo">✍️ MyBlog</div>

      <div class="user-info">
        <div class="user-avatar">
          <%= user ? user.userName.charAt(0).toUpperCase() : "A" %>
        </div>

        <span> <%= user ? user.userName : "Admin" %> </span>
      </div>
    </nav>

    <!-- =========================
       MAIN
  ========================== -->

    <main class="container">
      <!-- PAGE HEADER -->

      <section class="page-header">
        <h1>✨ Add New Blog Post</h1>

        <p>Share your thoughts, ideas and stories with the world.</p>
      </section>

      <!-- FORM CARD -->

      <section class="form-card">
        <h2 class="form-title">📝 Blog Information</h2>

        <!-- =========================
           ADD BLOG FORM
      ========================== -->

        <form action="/addblog" method="POST" enctype="multipart/form-data">
          <!-- TITLE -->

          <div class="form-group">
            <label for="title">
              Blog Title
              <span class="required">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="TitleName"
              placeholder="Enter an engaging blog title..."
              maxlength="100"
              required
            />

            <label for="SubTitleName">
              Blog Sub--Title
              <span class="required">*</span>
            </label>
            <input
              type="text"
              id="subtitle"
              name="SubTitleName"
              placeholder="Enter an engaging blog title..."
              maxlength="100"
              required
            />

            <label for="description">
              Blog Description
              <span class="required">*</span> </label
            ><input
              type="text"
              id="description"
              name="DescriptionName"
              placeholder="Enter an engaging blog title..."
              maxlength="100"
              required
            />

            <label for="image">
              Blog image
              <span class="required">*</span> </label
            ><input
              type="file"
              id="image"
              name="image"
              required
            />
          </div>
          <input type="submit" value="Add Blog" />
        </form>
      </section>
    </main>

    <!-- FOOTER -->

    <footer>
      © <%= new Date().getFullYear() %> MyBlog. All rights reserved.
    </footer>
  </body>
</html>
```
